{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorBrain Source",
  "description": "Source/Application metadata for error reporting",
  "type": "object",
  "required": [
    "language",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "python",
        "go",
        "typescript",
        "javascript",
        "deno",
        "rust",
        "cpp",
        "terraform",
        "other"
      ],
      "description": "Programming language or system"
    },
    "name": {
      "type": "string",
      "description": "Application/service name"
    },
    "version": {
      "type": "string",
      "description": "Application version (semver recommended)"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "development",
        "staging",
        "production"
      ],
      "description": "Deployment environment"
    },
    "hostname": {
      "type": "string",
      "description": "Hostname, container ID, or pod name"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Arbitrary tags for filtering"
    }
  }
}
