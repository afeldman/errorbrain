# ErrorBrain Docker Configuration
# Copy this file to .env and adjust values

# LLM Configuration
ERRORBRAIN_LLM_PROVIDER=openai
ERRORBRAIN_LLM_MODEL=local-model
ERRORBRAIN_LLM_BASE_URL=http://host.docker.internal:1234/v1
ERRORBRAIN_LLM_API_KEY=lm-studio

# Obsidian Vault Path (host system)
# Default: ./.obsidian (creates local directory)
# Example: /Users/anton.feldmann/lynq (mount real Obsidian vault)
OBSIDIAN_VAULT_PATH=./.obsidian
